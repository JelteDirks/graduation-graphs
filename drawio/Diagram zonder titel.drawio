        <mxCell id="vCfqc0yBNH5Kw_l7bIjO-57" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="uop exec latency is now set to the predicted exec latency which includes the PF latency" vertex="1">
          <mxGeometry height="120" width="290" x="610" y="265" as="geometry" />
        </mxCell>
        <mxCell id="Bvvmz2ziNXw94I25PW0E-1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="When this pseudoinstruction is handled by the core, it is counted as a serialize instruction (always 1 cycle latency). After being handled, it increments the cpi by the PF latency. The total cpi is thus incremented by&lt;div&gt;1 cycle (cpiSerialization)&lt;/div&gt;&lt;div&gt;[PF cycles] (cpiPageFault)&lt;/div&gt;&lt;div&gt;Done by perf model.&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="290" x="-320" y="-40" as="geometry" />
        </mxCell>
        <mxCell id="Bvvmz2ziNXw94I25PW0E-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="when LD A reaches the head of the ROB, it is counted as a regular stall and the remaining cycles from now until end of execution time is added to the respective cpi component.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;So, the cpi component will get time because the PF increased the exeuction time of LD A, even though it is also counted by perf model.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="370" x="395" y="-120" as="geometry" />
        </mxCell>
        <mxCell id="Bvvmz2ziNXw94I25PW0E-5" edge="1" parent="1" source="vCfqc0yBNH5Kw_l7bIjO-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=none;endFill=0;" target="Bvvmz2ziNXw94I25PW0E-6" value="">
